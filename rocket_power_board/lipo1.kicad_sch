	(text "Battery voltage sense:\n13V needs to map to 3: divide by 4.33\n"
		(exclude_from_sim no)
		(at 148.59 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1183c39d-a77c-49bb-88a6-a22acc54617d")
	)
	(text "If we use a 3S LiPo, JP1 and JP2 are to be disconnected,\nand the JST gets soldered on normally.\nIf we use a 2S LiPo, JP1 and JP2 are to be connected,\nand a 3 pin JST is to be soldered on pins 2, 3, and 4.\n"
		(exclude_from_sim no)
		(at 178.562 158.242 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "439bf746-9d68-4875-917c-ed5cf6af5572")
	)
	(text "For a 3S LiPo, R35 should be 64.9kR.\nFor a 2S LiPo, R35 should be 34.8kR.\n"
		(exclude_from_sim no)
		(at 178.816 146.812 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fb1f60f7-186e-429b-be64-cd9791416371")
	)
