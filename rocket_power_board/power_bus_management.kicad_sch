		(uuid "35d90a71-5390-45a2-9c5b-3605945df660")
	)
	(text "750 * 182 = 136500 uV/A (from efuse datasheet)\n136500 uV/A* 5A = 682500uV\n3.3V / 682500uV = 4.83x gain"
		(exclude_from_sim no)
		(at 57.15 193.548 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "39831e59-79c5-4f87-83ec-2e707703c88f")
	)
