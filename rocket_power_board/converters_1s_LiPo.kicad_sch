		(uuid "34a77672-fb5f-40e4-9116-5d0ae3a4e046")
	)
	(text "Common buck converter modified for 5V output\nThis is to allow for significantly easier featherweight charging,\nas 1S linear chargers can't accept high voltages and buck chargers\nhave complex wiring.\nAn LDO is added to drop the voltage down to 3.3V to power the MCU\n"
		(exclude_from_sim no)
		(at 94.234 79.756 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "4274c70c-9f61-4a30-94dd-05288835a2c5")
	)
	(text "30V CHG Line to 8.5V to power recelec while charge line connected"
