	(text "If we use a 3S LiPo, JP1 and JP2 are to be disconnected,\nand the JST gets soldered on normally.\nIf we use a 2S LiPo, JP1 and JP2 are to be connected,\nand a 3 pin JST is to be soldered on pins 2, 3, and 4.\n"
		(exclude_from_sim no)
		(at 181.61 132.08 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "7353a4b4-6dbb-444c-a44c-a33d525b2dd4")
	)
	(text "For a 3S LiPo, R44 should be 64.9kR.\nFor a 2S LiPo, R44 should be 34.8kR.\n"
		(exclude_from_sim no)
		(at 181.864 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
