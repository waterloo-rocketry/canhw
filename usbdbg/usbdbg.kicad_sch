	(text "It is also often a pain to wire up an external\nCAN bus resistor, this jumper makes it internal."
		(exclude_from_sim no)
		(at 204.216 161.798 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e0659ff0-8a24-428f-a0fb-e3fa9523143a")
	)
	(text "0.5A limit"
		(exclude_from_sim no)
		(at 218.186 74.168 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ee3f6187-0528-4b40-b9d9-545baaef302f")
	)
	(text "In some situations (namely, integration testing), we want the\nbus to be powered without having the radio board connected.\nBy moving a jumper on these pins, you can power the bus from\nthe USB port of your computer."
		(exclude_from_sim no)
		(at 204.216 152.908 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ffff33af-7c6b-494d-8311-77bb7e0f31aa")
	)
