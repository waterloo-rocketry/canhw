	(text "R4 is derived from the eqn:\nI_{limit} = 545/(R_{limt} + 72)\nsolving for R_{limit} using I_{limit}\n as 1A, we get R_{limit} =473\n ~470 does the job"
		(exclude_from_sim no)
		(at 159.004 104.394 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "002ebec6-02b2-4f5e-908d-59ade46f5cc1")
	)
	(text "C29 for cap if we want\n"
		(exclude_from_sim no)
		(at 185.928 105.156 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "045207d7-0250-458c-838e-b1b72bdd959f")
	)
	(text "LOW PASS FILTER \nFC = 1/(2(PI)(R)(C)) = 1/(2 * (PI) * (330) * (.1uF) =~ 500\nChosen FC : 500 Hz to accomadate any possible use of this pin \n(we need ~50hz of bandwidth and with\n 0.1ms rise time ~500 Hz does the job)\nExpected sampling rate is 4.8kHz\n\n"
		(exclude_from_sim no)
		(at 380.492 150.622 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0ddbf6af-49ba-4414-a3f6-b2c2690d5820")
	)
	(text "50VDC"
		(exclude_from_sim no)
		(at 133.858 77.978 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "76a1f06e-16be-488c-973f-422a695a7296")
	)
	(text "Connector and CAN BUS\n"
		(exclude_from_sim no)
		(at 83.82 39.624 0)
		(effects
